+// XRFrameRateController implementation. Sessions requested after
+// setFrameRates() let the page pick one of |supportedFrameRates|.
+MockRuntime.prototype.setFrameRates = function(supportedFrameRates, frameRate) {
+  this.supported_frame_rates_ = supportedFrameRates;
+  this.frame_rate_ = frameRate;
+  this.requested_frame_rates_ = [];
+};
+
+// Simulates the device switching to |frameRate|; the page sees it in the next
