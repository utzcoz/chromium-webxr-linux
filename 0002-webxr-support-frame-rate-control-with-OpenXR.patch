+  // fires frameratechange; it may take a few frames to switch.
+  frame_rate_controller->UpdateTargetFrameRate(
+      rate, resolver->WrapCallbackInScriptScope(blink::BindOnce(
+                [](ScriptPromiseResolver<IDLUndefined>* resolver) {
