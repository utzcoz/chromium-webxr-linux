new file mode 100644
index 0000000000000..235b15d131311
--- /dev/null
+++ b/device/vr/openxr/openxr_frame_rate_handler.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/vr/openxr/openxr_frame_rate_handler.h"
+
+#include <algorithm>
+
+#include "base/check.h"
+#include "device/vr/openxr/openxr_extension_helper.h"
+
+namespace device {
+
+// static
+const char* OpenXrFrameRateHandler::GetExtension() {
+  return XR_FB_DISPLAY_REFRESH_RATE_EXTENSION_NAME;
+}
+
+// static
+bool OpenXrFrameRateHandler::IsSupported(
+    const OpenXrExtensionEnumeration& extension_enum) {
+  return extension_enum.ExtensionSupported(GetExtension());
+}
+
+OpenXrFrameRateHandler::OpenXrFrameRateHandler(
+    const OpenXrExtensionHelper& extension_helper,
+    XrSession session)
+    : extension_helper_(extension_helper), session_(session) {
+  DCHECK(IsSupported(*extension_helper_->ExtensionEnumeration()));
+  const auto& methods = extension_helper_->ExtensionMethods();
+
+  float frame_rate = 0;
+  if (XR_SUCCEEDED(methods.xrGetDisplayRefreshRateFB(session_, &frame_rate)) &&
+      frame_rate > 0) {
+    frame_rate_ = frame_rate;
+  }
+
+  uint32_t count = 0;
+  if (XR_FAILED(methods.xrEnumerateDisplayRefreshRatesFB(session_, 0, &count,
+                                                         nullptr))) {
+    return;
+  }
+  std::vector<float> rates(count);
+  if (XR_FAILED(methods.xrEnumerateDisplayRefreshRatesFB(
+          session_, rates.size(), &count, rates.data()))) {
+    return;
+  }
+  rates.resize(count);
+  std::erase_if(rates, [](float rate) { return !(rate > 0); });
+  supported_frame_rates_ = std::move(rates);
+}
+
+OpenXrFrameRateHandler::~OpenXrFrameRateHandler() = default;
+
+XrResult OpenXrFrameRateHandler::RequestFrameRate(float rate) {
+  CHECK(std::ranges::contains(supported_frame_rates_, rate));
+  return extension_helper_->ExtensionMethods().xrRequestDisplayRefreshRateFB(
+      session_, rate);
+}
+
+void OpenXrFrameRateHandler::OnDisplayRefreshRateChanged(
+    const XrEventDataDisplayRefreshRateChangedFB& event) {
+  if (event.toDisplayRefreshRate > 0) {
+    frame_rate_ = event.toDisplayRefreshRate;
+  }
+}
+
+}  // namespace device
