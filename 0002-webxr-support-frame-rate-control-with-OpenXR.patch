@@ -0,0 +1,52 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef DEVICE_VR_OPENXR_OPENXR_FRAME_RATE_HANDLER_H_
+#define DEVICE_VR_OPENXR_OPENXR_FRAME_RATE_HANDLER_H_
+
+#include <optional>
+#include <vector>
+
+#include "base/memory/raw_ref.h"
+#include "device/vr/vr_export.h"
+#include "third_party/openxr/src/include/openxr/openxr.h"
+
+namespace device {
+
+class OpenXrExtensionEnumeration;
+class OpenXrExtensionHelper;
+
+// Reports and changes the display refresh rate with XR_FB_display_refresh_rate.
+class DEVICE_VR_EXPORT OpenXrFrameRateHandler {
+ public:
+  static const char* GetExtension();
+  static bool IsSupported(const OpenXrExtensionEnumeration& extension_enum);
+
+  OpenXrFrameRateHandler(const OpenXrExtensionHelper& extension_helper,
+                         XrSession session);
+  ~OpenXrFrameRateHandler();
+
+  // Empty if the runtime did not list any rate.
+  const std::vector<float>& supported_frame_rates() const {
+    return supported_frame_rates_;
+  }
+  std::optional<float> frame_rate() const { return frame_rate_; }
+
+  // |rate| must be one of the supported frame rates. The runtime reports the
+  // change later with an event.
+  XrResult RequestFrameRate(float rate);
+
+  void OnDisplayRefreshRateChanged(
+      const XrEventDataDisplayRefreshRateChangedFB& event);
+
+ private:
+  const raw_ref<const OpenXrExtensionHelper> extension_helper_;
+  const XrSession session_;
+  std::vector<float> supported_frame_rates_;
+  std::optional<float> frame_rate_;
+};
+
+}  // namespace device
+
+#endif  // DEVICE_VR_OPENXR_OPENXR_FRAME_RATE_HANDLER_H_
diff --git a/device/vr/openxr/openxr_frame_rate_handler_unittest.cc b/device/vr/openxr/openxr_frame_rate_handler_unittest.cc
new file mode 100644
index 0000000000000..ac090d60daaf1
--- /dev/null
+++ b/device/vr/openxr/openxr_frame_rate_handler_unittest.cc
@@ -0,0 +1,153 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/vr/openxr/openxr_frame_rate_handler.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/base_paths.h"
+#include "base/check.h"
+#include "base/files/file_path.h"
+#include "base/path_service.h"
+#include "base/scoped_environment_variable_override.h"
+#include "device/vr/openxr/linux/openxr_graphics_binding_vulkan.h"
+#include "device/vr/openxr/linux/openxr_platform_helper_linux.h"
+#include "device/vr/openxr/openxr_extension_helper.h"
+#include "device/vr/openxr/test/openxr_mock_helper.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/openxr/src/include/openxr/openxr.h"
+
+namespace device {
+
+namespace {
+
+// Points XR_RUNTIME_JSON at the mock runtime copied next to the test binary.
+std::unique_ptr<base::ScopedEnvironmentVariableOverride>
+UseMockOpenXrRuntime() {
+  base::FilePath dir;
+  CHECK(base::PathService::Get(base::DIR_EXE, &dir));
+  return std::make_unique<base::ScopedEnvironmentVariableOverride>(
+      "XR_RUNTIME_JSON",
+      dir.Append(FILE_PATH_LITERAL("mock_vr_clients/bin/openxr/openxr.json"))
+          .value());
+}
+
+// The mock runtime needs a Vulkan session; run it on SwiftShader.
+std::vector<std::unique_ptr<base::ScopedEnvironmentVariableOverride>>
+UseSwiftShaderVulkan() {
+  base::FilePath dir;
+  CHECK(base::PathService::Get(base::DIR_EXE, &dir));
+  const std::string icd_path =
+      dir.Append(FILE_PATH_LITERAL("vk_swiftshader_icd.json")).value();
+
+  std::vector<std::unique_ptr<base::ScopedEnvironmentVariableOverride>>
+      overrides;
+  overrides.push_back(std::make_unique<base::ScopedEnvironmentVariableOverride>(
+      "VK_DRIVER_FILES", icd_path));
+  overrides.push_back(std::make_unique<base::ScopedEnvironmentVariableOverride>(
+      "VK_ICD_FILENAMES", icd_path));
+  return overrides;
+}
+
+}  // namespace
+
+class OpenXrFrameRateHandlerTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    swiftshader_icd_ = UseSwiftShaderVulkan();
+    mock_runtime_ = UseMockOpenXrRuntime();
+    ASSERT_TRUE(InitializeOpenXrMockTrampoline());
+    helper_ = std::make_unique<OpenXrPlatformHelperLinux>();
+    ASSERT_TRUE(helper_->EnsureInitialized());
+    ASSERT_TRUE(XR_SUCCEEDED(helper_->CreateInstance(&instance_)));
+
+    XrSystemGetInfo system_info{XR_TYPE_SYSTEM_GET_INFO};
+    system_info.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+    ASSERT_TRUE(XR_SUCCEEDED(xrGetSystem(instance_, &system_info, &system_)));
+
+    binding_ = std::make_unique<OpenXrGraphicsBindingVulkan>(
+        helper_->GetExtensionEnumeration());
+    ASSERT_TRUE(binding_->Initialize(instance_, system_));
+    XrSessionCreateInfo create_info{XR_TYPE_SESSION_CREATE_INFO};
+    create_info.systemId = system_;
+    create_info.next = binding_->GetSessionCreateInfo();
+    ASSERT_TRUE(
+        XR_SUCCEEDED(xrCreateSession(instance_, &create_info, &session_)));
+
+    extension_helper_ = std::make_unique<OpenXrExtensionHelper>(
+        instance_, helper_->GetExtensionEnumeration());
+    ASSERT_TRUE(OpenXrFrameRateHandler::IsSupported(
+        *helper_->GetExtensionEnumeration()));
+  }
+
+  void TearDown() override {
+    extension_helper_.reset();
+    if (session_ != XR_NULL_HANDLE) {
+      xrDestroySession(session_);
+    }
+    binding_.reset();
+    if (instance_ != XR_NULL_HANDLE) {
+      helper_->DestroyInstance(instance_);
+    }
+    helper_.reset();
+  }
+
+  // Returns the next display refresh rate change event, if any.
+  std::optional<XrEventDataDisplayRefreshRateChangedFB> PollRateChange() {
+    XrEventDataBuffer event{XR_TYPE_EVENT_DATA_BUFFER};
+    while (xrPollEvent(instance_, &event) == XR_SUCCESS) {
+      if (event.type == XR_TYPE_EVENT_DATA_DISPLAY_REFRESH_RATE_CHANGED_FB) {
+        return *reinterpret_cast<XrEventDataDisplayRefreshRateChangedFB*>(
+            &event);
+      }
+      event.type = XR_TYPE_EVENT_DATA_BUFFER;
+    }
+    return std::nullopt;
+  }
+
+  std::vector<std::unique_ptr<base::ScopedEnvironmentVariableOverride>>
+      swiftshader_icd_;
+  std::unique_ptr<base::ScopedEnvironmentVariableOverride> mock_runtime_;
+  std::unique_ptr<OpenXrPlatformHelperLinux> helper_;
+  std::unique_ptr<OpenXrGraphicsBindingVulkan> binding_;
+  std::unique_ptr<OpenXrExtensionHelper> extension_helper_;
+  XrInstance instance_ = XR_NULL_HANDLE;
+  XrSystemId system_ = XR_NULL_SYSTEM_ID;
+  XrSession session_ = XR_NULL_HANDLE;
+};
+
+TEST_F(OpenXrFrameRateHandlerTest, ReportsRuntimeRates) {
+  OpenXrFrameRateHandler handler(*extension_helper_, session_);
+  EXPECT_THAT(handler.supported_frame_rates(),
+              testing::ElementsAre(72.0f, 90.0f, 120.0f));
+  EXPECT_EQ(handler.frame_rate(), 90.0f);
+}
+
+TEST_F(OpenXrFrameRateHandlerTest, RateChangesOnRuntimeEvent) {
+  OpenXrFrameRateHandler handler(*extension_helper_, session_);
+  EXPECT_TRUE(XR_SUCCEEDED(handler.RequestFrameRate(120.0f)));
+  // The runtime switches asynchronously, so the rate only changes once its
+  // event is handled.
+  EXPECT_EQ(handler.frame_rate(), 90.0f);
+
+  auto event = PollRateChange();
+  ASSERT_TRUE(event);
+  EXPECT_EQ(event->fromDisplayRefreshRate, 90.0f);
+  EXPECT_EQ(event->toDisplayRefreshRate, 120.0f);
+  handler.OnDisplayRefreshRateChanged(*event);
+  EXPECT_EQ(handler.frame_rate(), 120.0f);
+}
+
+TEST_F(OpenXrFrameRateHandlerTest, SameRateSendsNoEvent) {
+  OpenXrFrameRateHandler handler(*extension_helper_, session_);
+  EXPECT_TRUE(XR_SUCCEEDED(handler.RequestFrameRate(90.0f)));
+  EXPECT_FALSE(PollRateChange());
+  EXPECT_EQ(handler.frame_rate(), 90.0f);
+}
+
+}  // namespace device
