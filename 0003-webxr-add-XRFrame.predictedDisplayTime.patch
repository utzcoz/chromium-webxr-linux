+
+// Makes the device report a predicted display time with every frame, starting
+// at |startMicroseconds| (in base::TimeTicks units) and advancing by
+// |stepMicroseconds| per frame.
+MockRuntime.prototype.setPredictedDisplayTimes = function(startMicroseconds,
+                                                          stepMicroseconds) {
+  this.next_predicted_display_time_ = BigInt(startMicroseconds);
+  this.predicted_display_time_step_ = BigInt(stepMicroseconds);
+};
+
+MockRuntime.prototype._injectAdditionalFrameData_prePredictedDisplayTime =
+    MockRuntime.prototype._injectAdditionalFrameData;
+MockRuntime.prototype._injectAdditionalFrameData = function(options,
+                                                            frameData) {
+  this._injectAdditionalFrameData_prePredictedDisplayTime(options, frameData);
+  if (this.next_predicted_display_time_ !== undefined) {
+    frameData.predictedDisplayTime = {
+      internalValue: this.next_predicted_display_time_,
+    };
+    this.next_predicted_display_time_ += this.predicted_display_time_step_;
+  }
+};
diff --git a/third_party/blink/web_tests/wpt_internal/webxr/xrFrame_predictedDisplayTime.https.html b/third_party/blink/web_tests/wpt_internal/webxr/xrFrame_predictedDisplayTime.https.html
new file mode 100644
index 0000000000000..46d26e4a624a7
--- /dev/null
+++ b/third_party/blink/web_tests/wpt_internal/webxr/xrFrame_predictedDisplayTime.https.html
@@ -0,0 +1,59 @@
+<!DOCTYPE html>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>let additionalChromiumResources = ["resources/xr-internal-device-mocking.js"];</script>
+<script src="/webxr/resources/webxr_util.js"></script>
+<script src="/webxr/resources/webxr_test_constants.js"></script>
+
+<script>
+// The WebXR Test API cannot report display times, so this test drives the
+// chromium mock directly.
+
+// Resolves with the animation frame time and XRFrame of the next frame.
+function nextFrame(session) {
+  return new Promise(resolve => session.requestAnimationFrame(
+      (time, frame) => resolve({time, frame})));
+}
+
+xr_session_promise_test(
+    'predictedDisplayTime is the animation frame time for inline sessions',
+    async (session) => {
+      const {time, frame} = await nextFrame(session);
+      assert_equals(frame.predictedDisplayTime, time);
+    }, TRACKED_IMMERSIVE_DEVICE, 'inline');
+
+xr_session_promise_test(
+    'predictedDisplayTime is the animation frame time when the device does ' +
+        'not know when frames are displayed',
+    async (session) => {
+      const {time, frame} = await nextFrame(session);
+      assert_equals(frame.predictedDisplayTime, time);
+    }, TRACKED_IMMERSIVE_DEVICE, 'immersive-vr');
+
+xr_promise_test('predictedDisplayTime follows the device', async (t, gl) => {
+  const controller = await navigator.xr.test.simulateDeviceConnection(
+      TRACKED_IMMERSIVE_DEVICE);
+  // Well after the time origin, 50ms apart.
+  const stepMs = 50;
+  controller.setPredictedDisplayTimes(1e12, stepMs * 1000);
+  await gl.makeXRCompatible();
+  const session = await new Promise((resolve, reject) => {
+    navigator.xr.test.simulateUserActivation(() => {
+      navigator.xr.requestSession('immersive-vr').then(resolve, reject);
+    });
+  });
+  t.add_cleanup(() => session.end().catch(() => {}));
+  session.updateRenderState({baseLayer: new XRWebGLLayer(session, gl)});
+
+  const first = await nextFrame(session);
+  const second = await nextFrame(session);
+  const elapsed = second.frame.predictedDisplayTime -
+      first.frame.predictedDisplayTime;
+  // Frames may be skipped, so allow any whole number of steps. Timestamps are
+  // coarsened, so allow a little slack.
+  const steps = Math.round(elapsed / stepMs);
+  assert_greater_than_equal(steps, 1);
+  assert_approx_equals(elapsed, steps * stepMs, 0.2);
+  assert_not_equals(first.frame.predictedDisplayTime, first.time);
+}, {}, 'webgl');
+</script>
