+#if BUILDFLAG(ENABLE_OPENXR)
+class WebXrVrOpenXrFrameRateBrowserTest : public WebXrVrOpenXrBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    WebXrVrOpenXrBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kEnableBlinkFeatures,
+                                    "WebXRFrameRate");
+  }
+};
+
+// The fake runtime offers 72, 90 and 120 Hz, and starts at 90 Hz.
+IN_PROC_BROWSER_TEST_F(WebXrVrOpenXrFrameRateBrowserTest, TestFrameRate) {
+  MockXRDeviceHookBase my_mock;
+  LoadFileAndAwaitInitialization("test_webxr_frame_rate");
+  EnterSessionWithUserGestureOrFail();
+
+  RunJavaScriptOrFail(
+      "assert_array_equals(Array.from(immersiveSession().supportedFrameRates), "
+      "[72, 90, 120])");
+  PollJavaScriptBooleanOrFail("immersiveSession().frameRate === 90",
+                              kPollTimeoutMedium);
+
+  RunJavaScriptOrFail("updateTargetFrameRate(60)");
+  PollJavaScriptBooleanOrFail("updateResult === 'TypeError'",
+                              kPollTimeoutShort);
+
+  RunJavaScriptOrFail("updateTargetFrameRate(120)");
+  PollJavaScriptBooleanOrFail("updateResult === 'resolved'",
+                              kPollTimeoutMedium);
+  PollJavaScriptBooleanOrFail("immersiveSession().frameRate === 120",
+                              kPollTimeoutMedium);
+  RunJavaScriptOrFail("assert_equals(frameRateChanges, 1)");
+
+  RunJavaScriptOrFail("done()");
+  EndTest();
+}
+
+// updateTargetFrameRate() resolves without new frames.
+IN_PROC_BROWSER_TEST_F(WebXrVrOpenXrFrameRateBrowserTest,
+                       TestFrameRateUpdateWithoutFrames) {
+  MockXRDeviceHookBase my_mock;
+  LoadFileAndAwaitInitialization("test_webxr_frame_rate");
+  EnterSessionWithUserGestureOrFail();
+  PollJavaScriptBooleanOrFail("immersiveSession().frameRate === 90",
+                              kPollTimeoutMedium);
+
+  RunJavaScriptOrFail("stopFrameLoop()");
+  PollJavaScriptBooleanOrFail("frameLoopStopped", kPollTimeoutShort);
+  RunJavaScriptOrFail("updateTargetFrameRate(120)");
+  PollJavaScriptBooleanOrFail("updateResult === 'resolved'",
+                              kPollTimeoutMedium);
+
+  RunJavaScriptOrFail("done()");
+  EndTest();
+}
+
+// Ending the session rejects a pending updateTargetFrameRate().
+IN_PROC_BROWSER_TEST_F(WebXrVrOpenXrFrameRateBrowserTest,
+                       TestEndingSessionRejectsPendingFrameRateUpdate) {
+  MockXRDeviceHookBase my_mock;
+  LoadFileAndAwaitInitialization("test_webxr_frame_rate");
+  EnterSessionWithUserGestureOrFail();
+  PollJavaScriptBooleanOrFail("immersiveSession().frameRate === 90",
+                              kPollTimeoutMedium);
+
+  RunJavaScriptOrFail("updateTargetFrameRateAndEndSession(120)");
+  PollJavaScriptBooleanOrFail("updateResult === 'InvalidStateError'",
+                              kPollTimeoutShort);
+
+  RunJavaScriptOrFail("done()");
+  EndTest();
+}
+#endif  // BUILDFLAG(ENABLE_OPENXR)
+
 }  // namespace vr
diff --git a/chrome/test/data/xr/e2e_test_files/html/test_webxr_frame_rate.html b/chrome/test/data/xr/e2e_test_files/html/test_webxr_frame_rate.html
new file mode 100644
index 0000000000000..0286b209536cf
--- /dev/null
+++ b/chrome/test/data/xr/e2e_test_files/html/test_webxr_frame_rate.html
@@ -0,0 +1,59 @@
+<!doctype html>
+<!--
+Helpers for the XRSession frame rate tests.
+-->
+<html>
+  <head>
+    <link rel="stylesheet" type="text/css" href="../resources/webxr_e2e.css">
+  </head>
+  <body>
+    <canvas id="webgl-canvas"></canvas>
+    <script src="../../../../../../third_party/blink/web_tests/resources/testharness.js"></script>
+    <script src="../resources/webxr_e2e.js"></script>
+    <script src="../resources/webxr_boilerplate.js"></script>
+    <script>
+      let frameRateChanges = 0;
+
+      onSessionStartedCallback = function(session) {
+        if (session.mode !== 'immersive-vr') {
+          return;
+        }
+        session.addEventListener('frameratechange', () => frameRateChanges++);
+      }
+
+      function immersiveSession() {
+        return sessionInfos[sessionTypes.IMMERSIVE].currentSession;
+      }
+
+      // The outcome of the last updateTargetFrameRate(): 'resolved', an error
+      // name, or null while pending.
+      let updateResult = null;
+
+      function updateTargetFrameRate(rate) {
+        updateResult = null;
+        immersiveSession().updateTargetFrameRate(rate).then(
+            () => { updateResult = 'resolved'; },
+            (error) => { updateResult = error.name; });
+      }
+
+      function updateTargetFrameRateAndEndSession(rate) {
+        updateTargetFrameRate(rate);
+        immersiveSession().end();
+      }
+
+      // Stops the immersive session's frame loop after its next frame.
+      let frameLoopStopped = false;
+
+      function stopFrameLoop() {
+        const onFrame = onXRFrame;
+        onXRFrame = (time, frame) => {
+          if (frame.session !== immersiveSession()) {
+            onFrame(time, frame);
+            return;
+          }
+          frameLoopStopped = true;
+        };
+      }
+    </script>
+  </body>
+</html>
