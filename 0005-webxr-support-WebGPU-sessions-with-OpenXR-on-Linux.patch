diff --git a/third_party/blink/renderer/modules/xr/xr_gpu_copy_swap_chain.cc b/third_party/blink/renderer/modules/xr/xr_gpu_copy_swap_chain.cc
new file mode 100644
index 0000000000000..0200505255c88
--- /dev/null
+++ b/third_party/blink/renderer/modules/xr/xr_gpu_copy_swap_chain.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/xr/xr_gpu_copy_swap_chain.h"
+
+#include "components/viz/common/resources/shared_image_format.h"
+#include "gpu/command_buffer/client/raster_interface.h"
+#include "gpu/command_buffer/client/shared_image_interface.h"
+#include "gpu/command_buffer/common/shared_image_usage.h"
+#include "third_party/blink/renderer/modules/webgpu/gpu_device.h"
+#include "third_party/blink/renderer/modules/xr/xr_composition_layer.h"
+#include "third_party/blink/renderer/modules/xr/xr_layer_shared_image_manager.h"
+#include "third_party/blink/renderer/platform/graphics/gpu/shared_gpu_context.h"
+#include "third_party/blink/renderer/platform/graphics/web_graphics_context_3d_provider_wrapper.h"
+#include "ui/gfx/color_space.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+
+XRGPUCopySwapChain::XRGPUCopySwapChain(GPUDevice* device,
+                                       const wgpu::TextureDescriptor& desc)
+    : XRGPUSwapChain(device) {
+  descriptor_ = desc;
+
+  // TODO(crbug.com/359418629): Internal Usage will not be necessary once we can
+  // use texture array mailboxes directly.
+  texture_internal_usage_ = {{
+      .internalUsage = wgpu::TextureUsage::CopyDst,
+  }};
+  descriptor_.nextInChain = &texture_internal_usage_;
+}
+
+GPUTexture* XRGPUCopySwapChain::ProduceTexture() {
+  auto wrapper = SharedGpuContext::ContextProviderWrapper();
+  if (!shared_image_ && wrapper) {
+    gpu::SharedImageUsageSet usage = gpu::SHARED_IMAGE_USAGE_WEBGPU_READ |
+                                     gpu::SHARED_IMAGE_USAGE_WEBGPU_WRITE |
+                                     gpu::SHARED_IMAGE_USAGE_RASTER_READ;
+    gpu::SharedImageInterface* sii =
+        wrapper->ContextProvider().SharedImageInterface();
+    shared_image_ = sii->CreateSharedImage(
+        {viz::SinglePlaneFormat::kRGBA_8888,
+         gfx::Size(descriptor_.size.width, descriptor_.size.height),
+         gfx::ColorSpace::CreateSRGB(), usage, "XRGPUCopySwapChain"},
+        gpu::kNullSurfaceHandle);
+    sync_token_ = sii->GenVerifiedSyncToken();
+  }
+  if (!shared_image_) {
+    return GPUTexture::Create(device(), &descriptor_);
+  }
+
+  scoped_refptr<WebGPUMailboxTexture> mailbox_texture =
+      WebGPUMailboxTexture::FromExistingSharedImage(
+          device()->GetDawnControlClient(), device()->GetHandle(), descriptor_,
+          shared_image_, sync_token_);
+
+  return MakeGarbageCollected<GPUTexture>(
+      device(), descriptor_.format, descriptor_.usage,
+      std::move(mailbox_texture), "WebXR Copy Swap Chain");
+}
+
+void XRGPUCopySwapChain::OnFrameEnd() {
+  GPUTexture* texture = ResetCurrentTexture();
+  if (!texture || !shared_image_) {
+    return;
+  }
+  sync_token_ = texture->DissociateMailbox();
+
+  auto wrapper = SharedGpuContext::ContextProviderWrapper();
+  const XRSharedImageData& dest = layer()->SharedImage();
+  if (!wrapper || !dest.shared_image) {
+    return;
+  }
+
+  gpu::raster::RasterInterface* raster_interface =
+      wrapper->ContextProvider().RasterInterface();
+  std::unique_ptr<gpu::RasterScopedAccess> src_access =
+      shared_image_->BeginRasterAccess(raster_interface, sync_token_,
+                                       /*readonly=*/true);
+  std::unique_ptr<gpu::RasterScopedAccess> dst_access =
+      dest.shared_image->BeginRasterAccess(raster_interface, dest.sync_token,
+                                           /*readonly=*/false);
+  // The layer's shared image keeps its size whatever the layer's scale factor.
+  raster_interface->CopySharedImage(
+      shared_image_->mailbox(), dest.shared_image->mailbox(),
+      gfx::Rect(shared_image_->size()), gfx::Rect(dest.shared_image->size()));
+  gpu::RasterScopedAccess::EndAccess(std::move(dst_access));
+  sync_token_ = gpu::RasterScopedAccess::EndAccess(std::move(src_access));
+  raster_interface->Flush();
+}
+
+}  // namespace blink
