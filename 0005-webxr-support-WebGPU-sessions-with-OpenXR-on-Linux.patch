+  V8XRTextureType::Enum texture_type = V8XRTextureType::Enum::kTextureArray;
   if (session()->xr()->frameProvider()->DrawingIntoSharedBuffer()) {
+#if BUILDFLAG(IS_LINUX)
+    // WebGPU cannot write to the DMA-BUF shared buffers of Linux
+    // (crbug.com/330385376), so the side-by-side texture is copied into them.
