+
+void OpenXrVulkanContext::DestroyOverlayPipeline() {
+  if (vk_device_ != VK_NULL_HANDLE) {
+    // The set is freed with its pool.
+    vkDestroyPipeline(vk_device_, overlay_pipeline_, nullptr);
+    vkDestroyPipelineLayout(vk_device_, overlay_pipeline_layout_, nullptr);
+    vkDestroyDescriptorPool(vk_device_, overlay_descriptor_pool_, nullptr);
+    vkDestroyDescriptorSetLayout(vk_device_, overlay_set_layout_, nullptr);
+    vkDestroySampler(vk_device_, overlay_sampler_, nullptr);
+    vkDestroyRenderPass(vk_device_, overlay_clear_pass_, nullptr);
+    vkDestroyRenderPass(vk_device_, overlay_load_pass_, nullptr);
+  }
+  overlay_target_format_ = VK_FORMAT_UNDEFINED;
+  overlay_pipeline_ = VK_NULL_HANDLE;
+  overlay_pipeline_layout_ = VK_NULL_HANDLE;
+  overlay_descriptor_set_ = VK_NULL_HANDLE;
+  overlay_descriptor_pool_ = VK_NULL_HANDLE;
+  overlay_set_layout_ = VK_NULL_HANDLE;
+  overlay_sampler_ = VK_NULL_HANDLE;
+  overlay_clear_pass_ = VK_NULL_HANDLE;
+  overlay_load_pass_ = VK_NULL_HANDLE;
+}
