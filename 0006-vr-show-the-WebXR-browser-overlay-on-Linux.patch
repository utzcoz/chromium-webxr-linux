+  subpass.colorAttachmentCount = 1;
+  subpass.pColorAttachments = &color_ref;
+  VkRenderPassCreateInfo pass_ci{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+  pass_ci.attachmentCount = 1;
+  pass_ci.pAttachments = &attachment;
+  pass_ci.subpassCount = 1;
+  pass_ci.pSubpasses = &subpass;
+  attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+  attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  if (vkCreateRenderPass(vk_device_, &pass_ci, nullptr, &overlay_load_pass_) !=
+      VK_SUCCESS) {
