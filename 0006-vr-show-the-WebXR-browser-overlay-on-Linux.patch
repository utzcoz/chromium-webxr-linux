+                                      VkFormat overlay_format,
+                                      base::span<const OverlayDraw> draws) {
+  if (!EnsureOverlayPipeline(dst_format)) {
+    DLOG(ERROR) << __func__ << ": cannot create the overlay pipeline";
+    return false;
+  }
+
+  // The views and the framebuffer only live for this call, which waits for
+  // the GPU to finish with them.
+  VkImageViewCreateInfo view_ci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+  view_ci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  view_ci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  view_ci.image = dst;
+  view_ci.format = dst_format;
+  VkImageView dst_view = VK_NULL_HANDLE;
+  if (vkCreateImageView(vk_device_, &view_ci, nullptr, &dst_view) !=
+      VK_SUCCESS) {
+    return false;
+  }
+  VkImageView overlay_view = VK_NULL_HANDLE;
+  if (!draws.empty()) {
+    view_ci.image = overlay.image;
+    view_ci.format = overlay_format;
+    if (vkCreateImageView(vk_device_, &view_ci, nullptr, &overlay_view) !=
+        VK_SUCCESS) {
+      vkDestroyImageView(vk_device_, dst_view, nullptr);
+      return false;
+    }
+    VkDescriptorImageInfo image_info{overlay_sampler_, overlay_view,
+                                     VK_IMAGE_LAYOUT_GENERAL};
+    VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.dstSet = overlay_descriptor_set_;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    write.pImageInfo = &image_info;
+    vkUpdateDescriptorSets(vk_device_, 1, &write, 0, nullptr);
+  }
+  VkRenderPass pass = clear_alpha ? overlay_clear_pass_ : overlay_load_pass_;
+  VkFramebufferCreateInfo framebuffer_ci{
+      VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+  framebuffer_ci.renderPass = pass;
+  framebuffer_ci.attachmentCount = 1;
+  framebuffer_ci.pAttachments = &dst_view;
+  framebuffer_ci.width = static_cast<uint32_t>(dst_size.width());
+  framebuffer_ci.height = static_cast<uint32_t>(dst_size.height());
+  framebuffer_ci.layers = 1;
+  VkFramebuffer framebuffer = VK_NULL_HANDLE;
+  bool success = vkCreateFramebuffer(vk_device_, &framebuffer_ci, nullptr,
+                                     &framebuffer) == VK_SUCCESS;
+
+  VkCommandBufferBeginInfo begin_info{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  success = success &&
+            vkResetCommandBuffer(vk_command_buffer_, 0) == VK_SUCCESS &&
+            vkBeginCommandBuffer(vk_command_buffer_, &begin_info) == VK_SUCCESS;
+  if (success) {
+    std::vector<VkImageMemoryBarrier> barriers;
+    VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    if (!draws.empty() && overlay.current_layout != VK_IMAGE_LAYOUT_GENERAL) {
+      // First use; later frames keep GENERAL, which the GPU process's writes
+      // through the DMA-BUF leave untouched.
+      barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+      barrier.oldLayout = overlay.current_layout;
+      barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      barrier.image = overlay.image;
+      barriers.push_back(barrier);
+    }
+    if (!clear_alpha) {
+      // Draw over what CopyToSwapchainImage() wrote.
+      barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+      barrier.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT |
+                              VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      barrier.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      barrier.image = dst;
+      barriers.push_back(barrier);
+    }
+    if (!barriers.empty()) {
+      vkCmdPipelineBarrier(
+          vk_command_buffer_,
+          VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+          VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+          0, 0, nullptr, 0, nullptr, barriers.size(), barriers.data());
+    }
+
+    VkClearValue clear_value{};
+    clear_value.color = {{0.f, 0.f, 0.f, clear_alpha.value_or(0.f)}};
+    VkRenderPassBeginInfo pass_begin{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    pass_begin.renderPass = pass;
+    pass_begin.framebuffer = framebuffer;
+    pass_begin.renderArea.extent = {framebuffer_ci.width,
+                                    framebuffer_ci.height};
+    pass_begin.clearValueCount = 1;
+    pass_begin.pClearValues = &clear_value;
+    vkCmdBeginRenderPass(vk_command_buffer_, &pass_begin,
+                         VK_SUBPASS_CONTENTS_INLINE);
+    if (!draws.empty()) {
+      vkCmdBindPipeline(vk_command_buffer_, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                        overlay_pipeline_);
+      vkCmdBindDescriptorSets(
+          vk_command_buffer_, VK_PIPELINE_BIND_POINT_GRAPHICS,
+          overlay_pipeline_layout_, 0, 1, &overlay_descriptor_set_, 0, nullptr);
+    }
+    const gfx::Rect target_rect(dst_size);
+    for (const OverlayDraw& draw : draws) {
+      const gfx::Rect scissor = gfx::IntersectRects(draw.rect, target_rect);
+      if (scissor.IsEmpty()) {
+        continue;
+      }
+      VkViewport viewport{static_cast<float>(draw.rect.x()),
+                          static_cast<float>(draw.rect.y()),
+                          static_cast<float>(draw.rect.width()),
+                          static_cast<float>(draw.rect.height()),
+                          0.0f,
+                          1.0f};
+      vkCmdSetViewport(vk_command_buffer_, 0, 1, &viewport);
+      VkRect2D vk_scissor{{scissor.x(), scissor.y()},
+                          {static_cast<uint32_t>(scissor.width()),
+                           static_cast<uint32_t>(scissor.height())}};
+      vkCmdSetScissor(vk_command_buffer_, 0, 1, &vk_scissor);
+      const float uv_rect[] = {
+          draw.uv.x(), draw.flip_y ? draw.uv.bottom() : draw.uv.y(),
+          draw.uv.width(), draw.flip_y ? -draw.uv.height() : draw.uv.height()};
+      vkCmdPushConstants(vk_command_buffer_, overlay_pipeline_layout_,
+                         VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(uv_rect),
+                         uv_rect);
+      vkCmdDraw(vk_command_buffer_, 3, 1, 0, 0);
+    }
+    vkCmdEndRenderPass(vk_command_buffer_);
+    success = vkEndCommandBuffer(vk_command_buffer_) == VK_SUCCESS;
+  }
+
+  if (success) {
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &vk_command_buffer_;
+    vkResetFences(vk_device_, 1, &vk_frame_fence_);
+    success =
+        vkQueueSubmit(vk_queue_, 1, &submit, vk_frame_fence_) == VK_SUCCESS;
+    if (success) {
+      vkWaitForFences(vk_device_, 1, &vk_frame_fence_, VK_TRUE, UINT64_MAX);
+      if (!draws.empty()) {
+        overlay.current_layout = VK_IMAGE_LAYOUT_GENERAL;
+      }
+    }
+  }
+
+  vkDestroyFramebuffer(vk_device_, framebuffer, nullptr);
+  vkDestroyImageView(vk_device_, overlay_view, nullptr);
+  vkDestroyImageView(vk_device_, dst_view, nullptr);
+  return success;
+}
+
 }  // namespace device
