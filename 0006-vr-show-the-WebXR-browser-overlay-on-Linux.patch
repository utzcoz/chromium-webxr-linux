+bool OpenXrGraphicsBindingVulkan::CopyOverlay(
+    const scoped_refptr<viz::ContextProvider>& context_provider) {
+  gpu::gles2::GLES2Interface* gl =
+      context_provider ? context_provider->ContextGL() : nullptr;
+  if (!gl || !vulkan_->has_external_memory_fd()) {
+    return false;
+  }
+  const gfx::Size size = overlay_shared_image_->size();
+  // Recreate the copy for a new size, or with the new GPU context after the
+  // old one was lost.
+  if (!overlay_copy_ || overlay_copy_->size() != size ||
+      overlay_copy_sii_.get() != context_provider->SharedImageInterface()) {
+    ReleaseOverlayCopy();
+    // Use the swapchain's format, as CreateSharedImages() does: Ozone/X11 may
+    // only import BGRA, and sampling it with the swapchain's color encoding
+    // makes blending into an sRGB swapchain happen in linear space.
+    overlay_format_ = swapchain_format_;
+    const viz::SharedImageFormat si_format =
+        (swapchain_format_ == VK_FORMAT_B8G8R8A8_SRGB ||
+         swapchain_format_ == VK_FORMAT_B8G8R8A8_UNORM)
+            ? viz::SinglePlaneFormat::kBGRA_8888
+            : viz::SinglePlaneFormat::kRGBA_8888;
+    if (!vulkan_->CreateExportableImage(size, overlay_format_,
+                                        VK_IMAGE_USAGE_SAMPLED_BIT,
+                                        &overlay_image_)) {
+      return false;
+    }
+    overlay_copy_sii_ = context_provider->SharedImageInterface();
+    overlay_copy_ = ExportLinearImageAsSharedImage(
+        overlay_copy_sii_.get(),
+        {si_format, size, gfx::ColorSpace::CreateSRGB(),
+         gpu::SHARED_IMAGE_USAGE_DISPLAY_READ |
+             gpu::SHARED_IMAGE_USAGE_GLES2_READ |
+             gpu::SHARED_IMAGE_USAGE_GLES2_WRITE,
+         "OpenXrOverlay"},
+        overlay_image_);
+    if (!overlay_copy_) {
+      ReleaseOverlayCopy();
+      return false;
+    }
+  }
+
+  std::unique_ptr<gpu::SharedImageTexture> src =
+      overlay_shared_image_->CreateGLTexture(gl);
+  std::unique_ptr<gpu::SharedImageTexture::ScopedAccess> src_access =
+      src->BeginAccess(overlay_sync_token_, /*readonly=*/true);
+  std::unique_ptr<gpu::SharedImageTexture> dst =
+      overlay_copy_->CreateGLTexture(gl);
+  std::unique_ptr<gpu::SharedImageTexture::ScopedAccess> dst_access =
+      dst->BeginAccess(overlay_copy_->creation_sync_token(),
+                       /*readonly=*/false);
+  gl->CopySubTextureCHROMIUM(src_access->texture_id(), 0,
+                             overlay_copy_->GetTextureTarget(),
+                             dst_access->texture_id(), 0, 0, 0, 0, 0,
+                             size.width(), size.height(), false, false, false);
+  gpu::SharedImageTexture::ScopedAccess::EndAccess(std::move(dst_access));
+  gpu::SharedImageTexture::ScopedAccess::EndAccess(std::move(src_access));
+  // Like the D3D11 binding, finish before compositing.
+  gl->Finish();
+  return true;
+}
+
+void OpenXrGraphicsBindingVulkan::OnSetOverlayAndWebXrVisibility() {
+  if (!overlay_visible_) {
+    overlay_shared_image_.reset();
+    overlay_updated_ = false;
+    ReleaseOverlayCopy();
+  }
+}
+
+void OpenXrGraphicsBindingVulkan::ReleaseOverlayCopy() {
+  overlay_copy_.reset();
+  overlay_copy_sii_.reset();
+  if (vulkan_ && vulkan_->valid()) {
+    vulkan_->DestroyIntermediateImage(overlay_image_);
+  }
+  // A new image starts in VK_IMAGE_LAYOUT_UNDEFINED.
+  overlay_image_ = OpenXrVulkanContext::IntermediateImage();
+}
