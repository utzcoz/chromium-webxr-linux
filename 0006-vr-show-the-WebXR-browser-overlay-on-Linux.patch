+
+bool OpenXrGraphicsBindingVulkan::DrawOverlay(
+    OpenXrCompositionLayer& layer,
+    VkImage dst,
+    std::optional<float> clear_alpha,
+    const scoped_refptr<viz::ContextProvider>& context_provider) {
+  const gfx::Size size = layer.GetSwapchainImageSize();
+  std::vector<OpenXrVulkanContext::OverlayDraw> draws;
+  const bool draw_overlay =
+      overlay_visible_ && overlay_shared_image_ &&
+      layer.type() == OpenXrCompositionLayer::Type::kProjection;
+  if (draw_overlay && overlay_updated_) {
+    if (!CopyOverlay(context_provider)) {
+      return false;
+    }
+    overlay_updated_ = false;
+  }
+  if (draw_overlay && overlay_copy_) {
+    // The overlay is drawn bottom-up, like the page's WebGL content: flip it
+    // for layers the runtime does not flip.
+    const bool flip = !ShouldFlipSubmittedImage(layer);
+    for (const gfx::RectF& uv : {overlay_left_, overlay_right_}) {
+      gfx::RectF rect = gfx::ScaleRect(uv, size.width(), size.height());
+      if (flip) {
+        rect.set_y(size.height() - rect.bottom());
+      }
+      draws.push_back({gfx::ToEnclosingRect(rect), uv, flip});
+    }
+  }
+  return vulkan_->DrawOverlay(dst, swapchain_format_, size, clear_alpha,
+                              overlay_image_, overlay_format_, draws);
 }
 
