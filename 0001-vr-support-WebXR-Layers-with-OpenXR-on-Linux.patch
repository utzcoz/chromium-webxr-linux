         swapchain_images[j].sync_token = gpu::SyncToken();
@@ -283,16 +330,16 @@ void OpenXrGraphicsBindingVulkan::CreateSharedImages(
   for (size_t i = 0; i < swapchain_images.size(); ++i) {
