@@ -255,13 +302,13 @@ void OpenXrGraphicsBindingVulkan::CreateSharedImages(
     scoped_refptr<gpu::ClientSharedImage> client_si =
         ImportGbmImageAsSharedImage(sii, si_info, size, swapchain_format_,
