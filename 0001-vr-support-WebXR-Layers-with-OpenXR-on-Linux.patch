+  const bool flip_y =
+      ShouldFlipSubmittedImage(layer) &&
+      layer.type() != OpenXrCompositionLayer::Type::kProjection &&
+      !GetFlipLayerLayout(layer);
+  return vulkan_->CopyToSwapchainImage(src, dst, layer.GetSwapchainImageSize(),
+                                       flip_y);
 }
 
