diff --git a/device/vr/openxr/openxr_function.h b/device/vr/openxr/openxr_function.h
new file mode 100644
index 0000000000000..c77e4bc9d50c4
--- /dev/null
+++ b/device/vr/openxr/openxr_function.h
@@ -0,0 +1,38 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef DEVICE_VR_OPENXR_OPENXR_FUNCTION_H_
+#define DEVICE_VR_OPENXR_OPENXR_FUNCTION_H_
+
+#include "third_party/openxr/src/include/openxr/openxr.h"
+
+namespace device {
+
+template <typename T>
+class OpenXrFunction;
+
+template <typename R, typename... Args>
+class OpenXrFunction<R(XRAPI_PTR*)(Args...)> {
+ public:
+  using Fn = R(XRAPI_PTR*)(Args...);
+
+  OpenXrFunction() = default;
+  OpenXrFunction(Fn fn) : fn_(fn) {}
+
+  explicit operator bool() const { return !!fn_; }
+  // Calls through the raw pointer fail CFI checks.
+  operator Fn() const { return fn_; }
+
+  // The runtime is not built with Chromium's CFI; see tools/cfi/ignores.txt.
+  R operator()(Args... args) const { return fn_(args...); }
+
+  Fn* receive() { return &fn_; }
+
+ private:
+  Fn fn_ = nullptr;
+};
+
+}  // namespace device
+
+#endif  // DEVICE_VR_OPENXR_OPENXR_FUNCTION_H_
