+// Marks |inputSource|, as returned by simulateInputSourceConnection(), as
+// auxiliary: it has no primary action, which makes it a tracked source.
+function setInputSourceAuxiliary(inputSource, auxiliary) {
+  inputSource._getInputSourceState_preAuxiliary ??=
+      inputSource._getInputSourceState;
+  inputSource._getInputSourceState = function() {
+    const state = this._getInputSourceState_preAuxiliary();
+    state.isAuxiliary = auxiliary;
+    return state;
+  };
+}
diff --git a/third_party/blink/web_tests/wpt_internal/webxr/xrInputSource_skipRendering.https.html b/third_party/blink/web_tests/wpt_internal/webxr/xrInputSource_skipRendering.https.html
