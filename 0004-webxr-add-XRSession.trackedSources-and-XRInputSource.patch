--- /dev/null
+++ b/third_party/blink/web_tests/wpt_internal/webxr/xrInputSource_skipRendering.https.html
@@ -0,0 +1,35 @@
+<!DOCTYPE html>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script src="/webxr/resources/webxr_util.js"></script>
+<script src="/webxr/resources/webxr_test_constants.js"></script>
+
+<script>
+// skipRendering follows whether the display is see-through, which is up to the
+// user agent, so this test is chromium specific.
+
+function connectedSource(session, fakeDeviceController) {
+  // Input sources are only updated while the page asks for frames.
+  const onFrame = () => session.requestAnimationFrame(onFrame);
+  session.requestAnimationFrame(onFrame);
+  fakeDeviceController.simulateInputSourceConnection(RIGHT_CONTROLLER);
+  return new Promise(resolve => session.addEventListener(
+      'inputsourceschange', e => resolve(e.added[0]), {once: true}));
+}
+
+xr_session_promise_test(
+    'Input sources must be rendered on an opaque display',
+    async (session, fakeDeviceController) => {
+      assert_equals(session.environmentBlendMode, 'opaque');
+      const source = await connectedSource(session, fakeDeviceController);
+      assert_false(source.skipRendering);
+    }, TRACKED_IMMERSIVE_DEVICE, 'immersive-vr');
+
+xr_session_promise_test(
+    'Input sources need not be rendered on a see-through display',
+    async (session, fakeDeviceController) => {
+      assert_equals(session.environmentBlendMode, 'additive');
+      const source = await connectedSource(session, fakeDeviceController);
+      assert_true(source.skipRendering);
+    }, IMMERSIVE_AR_DEVICE, 'immersive-ar');
+</script>
diff --git a/third_party/blink/web_tests/wpt_internal/webxr/xrSession_trackedSources.https.html b/third_party/blink/web_tests/wpt_internal/webxr/xrSession_trackedSources.https.html
new file mode 100644
index 0000000000000..3bcce723a3429
--- /dev/null
+++ b/third_party/blink/web_tests/wpt_internal/webxr/xrSession_trackedSources.https.html
@@ -0,0 +1,97 @@
+<!DOCTYPE html>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>let additionalChromiumResources = ["resources/xr-internal-device-mocking.js"];</script>
+<script src="/webxr/resources/webxr_util.js"></script>
+<script src="/webxr/resources/webxr_test_constants.js"></script>
+
+<script>
+// The WebXR Test API cannot create tracked sources, so this test marks input
+// sources as auxiliary through the chromium mock.
+
+const fakeDeviceInitParams = {
+  ...TRACKED_IMMERSIVE_DEVICE,
+  supportedFeatures: ALL_FEATURES.concat(['tracked-sources']),
+};
+
+function nextEvent(session, type) {
+  return new Promise(resolve =>
+      session.addEventListener(type, resolve, {once: true}));
+}
+
+// Input sources are only updated while the page asks for frames.
+function runFrameLoop(session) {
+  const onFrame = () => session.requestAnimationFrame(onFrame);
+  session.requestAnimationFrame(onFrame);
+}
+
+function skipFrames(session) {
+  return new Promise(resolve => requestSkipAnimationFrame(session, resolve));
+}
+
+xr_session_promise_test(
+    'Tracked sources are hidden without the tracked-sources feature',
+    async (session, fakeDeviceController) => {
+      const primary =
+          fakeDeviceController.simulateInputSourceConnection(VALID_CONTROLLER);
+      const tracked =
+          fakeDeviceController.simulateInputSourceConnection(RIGHT_CONTROLLER);
+      setInputSourceAuxiliary(tracked, true);
+      session.addEventListener('trackedsourceschange',
+                               () => assert_unreached('trackedsourceschange'));
+      await skipFrames(session);
+
+      assert_equals(session.inputSources.length, 1);
+      assert_equals(session.inputSources[0].handedness, 'none');
+      assert_equals(session.trackedSources.length, 0);
+    }, fakeDeviceInitParams, 'immersive-vr');
+
+xr_session_promise_test(
+    'Tracked sources are reported with the tracked-sources feature',
+    async (session, fakeDeviceController) => {
+      assert_true(session.enabledFeatures.includes('tracked-sources'));
+      runFrameLoop(session);
+      const tracked =
+          fakeDeviceController.simulateInputSourceConnection(RIGHT_CONTROLLER);
+      setInputSourceAuxiliary(tracked, true);
+
+      const added = await nextEvent(session, 'trackedsourceschange');
+      assert_true(added instanceof XRInputSourcesChangeEvent);
+      assert_equals(added.added.length, 1);
+      assert_equals(added.removed.length, 0);
+      assert_equals(added.added[0].handedness, 'right');
+      assert_equals(session.trackedSources.length, 1);
+      assert_equals(session.trackedSources[0], added.added[0]);
+      assert_equals(session.inputSources.length, 0);
+
+      tracked.disconnect();
+      const removed = await nextEvent(session, 'trackedsourceschange');
+      assert_equals(removed.added.length, 0);
+      assert_equals(removed.removed.length, 1);
+      assert_equals(removed.removed[0], added.added[0]);
+      assert_equals(session.trackedSources.length, 0);
+    }, fakeDeviceInitParams, 'immersive-vr',
+    {requiredFeatures: ['tracked-sources']});
+
+xr_session_promise_test(
+    'A source that loses its primary action moves to trackedSources',
+    async (session, fakeDeviceController) => {
+      runFrameLoop(session);
+      const source =
+          fakeDeviceController.simulateInputSourceConnection(RIGHT_CONTROLLER);
+      const connected = await nextEvent(session, 'inputsourceschange');
+      const primary = connected.added[0];
+      assert_equals(session.inputSources.length, 1);
+
+      const removed = nextEvent(session, 'inputsourceschange');
+      const added = nextEvent(session, 'trackedsourceschange');
+      setInputSourceAuxiliary(source, true);
+      assert_equals((await removed).removed[0], primary);
+      const tracked = (await added).added[0];
+      assert_not_equals(tracked, primary);
+      assert_equals(tracked.handedness, 'right');
+      assert_equals(session.inputSources.length, 0);
+      assert_equals(session.trackedSources.length, 1);
+    }, fakeDeviceInitParams, 'immersive-vr',
+    {requiredFeatures: ['tracked-sources']});
+</script>
